<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One conversion job per process, then exit.

    Deliberately a separate process from the Host: this is where untrusted
    image bytes get parsed. libheif, libaom and friends have a CVE history, and
    a malformed HEIC that segfaults the decoder must kill a disposable child,
    not the queue.

    Phase 6 adds the restricted token, the Job Object memory cap and the
    per-file timeout. Getting the process boundary right now is much cheaper
    than retrofitting it later.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <AssemblyName>Jalyro.Convert.Worker</AssemblyName>
    <RootNamespace>Jalyro.Convert.Worker</RootNamespace>
    <Version>0.9.36</Version>

    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- longPathAware; see app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NetVips        MIT
      NetVips.Native LGPL-3.0-or-later, statically linked prebuilt binaries.

      win-x64 only, not the NetVips.Native meta-package, which would drag in
      every platform's binaries (~30 MB each).

      NOTE: this build of libvips has NO HEVC decoder, so it cannot read HEIC
      at all - see docs/decisions.md. HEIC is decoded by ffmpeg instead, which
      still means no Microsoft Store purchase is needed. HEIC ENCODE would
      require x265 (GPL) and is not supported, by design.
    -->
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.4" />
  </ItemGroup>

</Project>
